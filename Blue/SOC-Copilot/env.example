# Copy this file to .env (in the project root) and fill in your key.
# soc_copilot/config.py loads .env automatically - no python-dotenv needed.

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# Correlation window: alerts on the same client+host within this many minutes
# of each other are grouped into one incident. Rarely needs changing.
# SOC_CORRELATION_WINDOW_MIN=60

# Approximate $/1M tokens used for the cost tracker (economics/cost.py).
# Defaults match Claude Sonnet list pricing; override if you're on a different
# model or have a negotiated rate.
# SOC_COST_PER_1M_INPUT=3.00
# SOC_COST_PER_1M_OUTPUT=15.00
