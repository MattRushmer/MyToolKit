# Optional: enables `agentwarden review-task`'s Claude second opinion on a
# task's full audit narrative. Without this, everything else works fully.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Where session/grant/audit state (SQLite) and the demo DB are written.
AGENTWARDEN_STATE_DIR=.agentwarden_state

# Default grant TTL and blast-radius ceiling when a policy rule or `serve`
# config doesn't set its own.
AGENTWARDEN_DEFAULT_TTL_SECONDS=60
AGENTWARDEN_BLAST_RADIUS_CEILING=3

# Per-upstream connection timeout.
AGENTWARDEN_UPSTREAM_TIMEOUT_SECONDS=15
