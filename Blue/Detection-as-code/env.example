# Copy this file to .env (in the project root) and fill in your key.
# detection_forge/config.py loads .env automatically - no python-dotenv needed.

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-5

# Noise score thresholds (0-100 scale, higher = noisier). Rarely need changing.
# DF_NOISE_CRITICAL=80
# DF_NOISE_HIGH=55
# DF_NOISE_MEDIUM=30
# DF_MAX_GEN_RETRIES=2
