# Optional: enables LLM-assisted judgement of tool-response injection probes.
# Without this, MCP Sentinel falls back to heuristic pattern matching only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Seconds to wait for an MCP server to respond to a single request before
# treating it as unresponsive.
MCP_SENTINEL_TIMEOUT_SECONDS=15

# Where scan baselines (for rug-pull / drift detection) are persisted.
MCP_SENTINEL_STATE_DIR=.mcp_sentinel
