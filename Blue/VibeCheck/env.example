# Optional: enables the --llm-judge second-opinion pass on hallucinated-auth
# findings. Without this, VibeCheck runs entirely on static rules.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Seconds to wait for a single PyPI/npm registry lookup during --check-deps.
VIBECHECK_REGISTRY_TIMEOUT_SECONDS=5

# Where dependency-registry lookup results are cached between scans.
VIBECHECK_CACHE_DIR=.vibecheck_cache

# Files larger than this are skipped rather than scanned.
VIBECHECK_MAX_FILE_BYTES=2000000
